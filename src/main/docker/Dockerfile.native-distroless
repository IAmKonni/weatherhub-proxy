####
# Native (no JVM) image based on a distroless base. This is the image published to Docker Hub.
#
# Build the native executable first (no local GraalVM needed, Docker is enough):
#
#   ./mvnw package -Dnative -Dquarkus.native.container-build=true
#
# Then build and run the image:
#
#   docker build -f src/main/docker/Dockerfile.native-distroless -t weatherhub-proxy .
#   docker run -i --rm -p 8080:8080 weatherhub-proxy
###
FROM quay.io/quarkus/quarkus-distroless-image:2.0
COPY target/*-runner /application

EXPOSE 8080
USER nonroot

ENTRYPOINT ["/application", "-Dquarkus.http.host=0.0.0.0"]
