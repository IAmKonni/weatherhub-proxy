####
# Native (no JVM) image based on the UBI 9 micro image.
#
# Build the native executable first (no local GraalVM needed, Docker is enough):
#
#   ./mvnw package -Dnative -Dquarkus.native.container-build=true
#
# Then build and run the image:
#
#   docker build -f src/main/docker/Dockerfile.native -t weatherhub-proxy .
#   docker run -i --rm -p 8080:8080 weatherhub-proxy
###
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
